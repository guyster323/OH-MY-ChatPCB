From 6818a8e28daa09c1313adbc3080081acdeaa7ef5 Mon Sep 17 00:00:00 2001
From: guyster323 <window98se@gmail.com>
Date: Sat, 6 Jun 2026 21:42:21 +0900
Subject: [PATCH] feat: wire ChatPCB panel into schematic editor

---
 CMakeLists.txt                | 58 +++++++++++++++++++++++++++++++++++
 cmake/ConfigurePlatform.cmake | 15 ++++++++-
 eeschema/CMakeLists.txt       |  2 ++
 eeschema/sch_edit_frame.cpp   | 12 ++++++++
 eeschema/sch_edit_frame.h     |  7 +++++
 5 files changed, 93 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 10290793da7..355430ba2ad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1096,6 +1096,12 @@ include( CTest )
 enable_testing()
 list( APPEND CMAKE_CTEST_ARGUMENTS "--output-on-failure" )

+install( DIRECTORY ${CMAKE_SOURCE_DIR}/share/chatpcb_panel
+         DESTINATION ${KICAD_DATA} )
+
+file( COPY ${CMAKE_SOURCE_DIR}/share/chatpcb_panel
+      DESTINATION ${CMAKE_BINARY_DIR}/share )
+
 #================================================
 # Let CMake look in these directories for nested
 # 'CMakeLists.txt' files to process
@@ -1104,11 +1110,63 @@ list( APPEND CMAKE_CTEST_ARGUMENTS "--output-on-failure" )
 # Binaries ( CMake targets )
 add_subdirectory( api )
 add_subdirectory( resources )
+
+add_custom_target( chatpcb_build_runtime_assets
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            ${CMAKE_SOURCE_DIR}/share/chatpcb_panel
+            ${CMAKE_BINARY_DIR}/share/chatpcb_panel
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            ${CMAKE_SOURCE_DIR}/api/schemas
+            ${CMAKE_BINARY_DIR}/schemas
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            ${CMAKE_SOURCE_DIR}/api/schemas/api.v1.schema.json
+            ${CMAKE_BINARY_DIR}/api.v1.schema.json
+    COMMAND ${CMAKE_COMMAND} -E make_directory
+            ${CMAKE_BINARY_DIR}/share/kicad/schemas
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            ${CMAKE_SOURCE_DIR}/api/schemas/api.v1.schema.json
+            ${CMAKE_BINARY_DIR}/share/kicad/schemas/api.v1.schema.json
+    COMMAND ${CMAKE_COMMAND} -E make_directory
+            ${CMAKE_BINARY_DIR}/share/kicad/resources
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            ${CMAKE_BINARY_DIR}/resources/images.tar.gz
+            ${CMAKE_BINARY_DIR}/share/kicad/resources/images.tar.gz
+    DEPENDS bitmap_archive_build
+    COMMENT "Preparing ChatPCB development runtime assets"
+    )
+
 add_subdirectory( thirdparty )
 add_subdirectory( libs )
 add_subdirectory( common )
 add_subdirectory( 3d-viewer )
 add_subdirectory( eeschema )
+
+if( TARGET eeschema )
+    add_dependencies( eeschema chatpcb_build_runtime_assets )
+
+    if( WIN32 )
+        add_custom_target( chatpcb_eeschema_runtime_dlls
+            COMMAND ${CMAKE_COMMAND} -E make_directory
+                    $<TARGET_FILE_DIR:eeschema>
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                    $<TARGET_FILE:kicommon>
+                    $<TARGET_FILE_DIR:eeschema>
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                    $<TARGET_FILE:gal>
+                    $<TARGET_FILE_DIR:eeschema>
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                    $<TARGET_FILE:kiapi>
+                    $<TARGET_FILE_DIR:eeschema>
+            COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                    ${CMAKE_BINARY_DIR}/common/nng.dll
+                    $<TARGET_FILE_DIR:eeschema>/nng.dll
+            DEPENDS kicommon gal kiapi
+            COMMENT "Preparing ChatPCB schematic editor runtime DLLs"
+            )
+        add_dependencies( eeschema chatpcb_eeschema_runtime_dlls )
+    endif()
+endif()
+
 add_subdirectory( gerbview )
 add_subdirectory( pcbnew )
 add_subdirectory( pagelayout_editor )
diff --git a/cmake/ConfigurePlatform.cmake b/cmake/ConfigurePlatform.cmake
index 8daf035a3ef..4e5f93aa5ba 100644
--- a/cmake/ConfigurePlatform.cmake
+++ b/cmake/ConfigurePlatform.cmake
@@ -23,7 +23,18 @@ if( MSVC )

     # CMake does not set CMAKE_SYSTEM_PROCESSOR correctly for MSVC
     # and it will always return the host instead of the target arch
-    if("${CMAKE_HOST_SYSTEM_PROCESSOR}" STREQUAL "ARM64")
+    if("${CMAKE_HOST_SYSTEM_PROCESSOR}" STREQUAL "")
+        set( KICAD_HOST_ARCH "${KICAD_BUILD_ARCH}" )
+        if(KICAD_BUILD_ARCH_ARM64)
+            set( KICAD_HOST_ARCH_ARM64 1 )
+        elseif(KICAD_BUILD_ARCH_ARM)
+            set( KICAD_HOST_ARCH_ARM 1 )
+        elseif(KICAD_BUILD_ARCH_X86)
+            set( KICAD_HOST_ARCH_X86 1 )
+        elseif(KICAD_BUILD_ARCH_X64)
+            set( KICAD_HOST_ARCH_X64 1 )
+        endif()
+    elseif("${CMAKE_HOST_SYSTEM_PROCESSOR}" STREQUAL "ARM64")
         set( KICAD_HOST_ARCH "arm64" )
         set( KICAD_HOST_ARCH_ARM64 1 )
     elseif("${CMAKE_HOST_SYSTEM_PROCESSOR}" STREQUAL "ARM")
@@ -97,4 +108,4 @@ if( MSVC )
         set(CMAKE_ASM_MASM_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreadedDebug    "")
         set(CMAKE_ASM_MASM_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreadedDebugDLL "")
     endif()
-endif()
\ No newline at end of file
+endif()
diff --git a/eeschema/CMakeLists.txt b/eeschema/CMakeLists.txt
index 50df827466d..3a1203c7499 100644
--- a/eeschema/CMakeLists.txt
+++ b/eeschema/CMakeLists.txt
@@ -409,6 +409,7 @@ set( EESCHEMA_SRCS
     sch_collectors.cpp
     sch_commit.cpp
     sch_connection.cpp
+    ${CMAKE_SOURCE_DIR}/plugins/chatpcb_panel/chatpcb_panel.cpp
     sch_draw_panel.cpp
     sch_edit_frame.cpp
     sch_field.cpp
@@ -632,6 +633,7 @@ target_include_directories( eeschema_kiface_objects
     PUBLIC
         .
         netlist_exporters
+        ${CMAKE_SOURCE_DIR}/plugins/chatpcb_panel
      )

 target_link_libraries( eeschema_kiface_objects
diff --git a/eeschema/sch_edit_frame.cpp b/eeschema/sch_edit_frame.cpp
index eda545f35be..676da10f94c 100644
--- a/eeschema/sch_edit_frame.cpp
+++ b/eeschema/sch_edit_frame.cpp
@@ -34,6 +34,7 @@
 #include <dialogs/dialog_symbol_fields_table.h>
 #include <widgets/sch_design_block_pane.h>
 #include <widgets/panel_remote_symbol.h>
+#include <chatpcb_panel.h>
 #include <wx/srchctrl.h>
 #include <mail_type.h>
 #include <wx/clntdata.h>
@@ -232,6 +233,7 @@ SCH_EDIT_FRAME::SCH_EDIT_FRAME( KIWAY* aKiway, wxWindow* aParent ) :
     m_searchPane = new SCH_SEARCH_PANE( this );
     m_propertiesPanel = new SCH_PROPERTIES_PANEL( this, this );
     m_remoteSymbolPane = new PANEL_REMOTE_SYMBOL( this );
+    m_chatPcbPanel = new CHATPCB_PANEL( this );

     m_propertiesPanel->SetSplitterProportion( eeconfig()->m_AuiPanels.properties_splitter );

@@ -272,6 +274,16 @@ SCH_EDIT_FRAME::SCH_EDIT_FRAME( KIWAY* aKiway, wxWindow* aParent ) :

     m_auimgr.AddPane( m_designBlocksPane, defaultDesignBlocksPaneInfo( this ) );
     m_auimgr.AddPane( m_remoteSymbolPane, defaultRemoteSymbolPaneInfo( this ) );
+    m_auimgr.AddPane( m_chatPcbPanel, EDA_PANE().Palette().Name( ChatPcbPaneName() )
+                      .Caption( wxS( "ChatPCB" ) )
+                      .Right().Layer( 3 ).Position( 3 )
+                      .TopDockable( false )
+                      .BottomDockable( false )
+                      .CloseButton( true )
+                      .MinSize( FromDIP( wxSize( 280, 240 ) ) )
+                      .BestSize( FromDIP( wxSize( 360, 600 ) ) )
+                      .FloatingSize( FromDIP( wxSize( 420, 640 ) ) )
+                      .Show( true ) );

     m_auimgr.AddPane( createHighlightedNetNavigator(), defaultNetNavigatorPaneInfo() );

diff --git a/eeschema/sch_edit_frame.h b/eeschema/sch_edit_frame.h
index 2e6246b01bb..a5d2936cd8d 100644
--- a/eeschema/sch_edit_frame.h
+++ b/eeschema/sch_edit_frame.h
@@ -60,6 +60,7 @@ class SCHEMATIC;
 class SCH_COMMIT;
 class SCH_DESIGN_BLOCK_PANE;
 class PANEL_REMOTE_SYMBOL;
+class CHATPCB_PANEL;
 class DIALOG_BOOK_REPORTER;
 class DIALOG_ERC;
 class DIALOG_SYMBOL_FIELDS_TABLE;
@@ -911,6 +912,11 @@ class SCH_EDIT_FRAME : public SCH_BASE_FRAME
         return wxS( "NetNavigator" );
     }

+    static const wxString ChatPcbPaneName()
+    {
+        return wxS( "ChatPCB" );
+    }
+
     void RefreshNetNavigator( const NET_NAVIGATOR_ITEM_DATA* aSelection = nullptr );

     void MakeNetNavigatorNode( const wxString& aNetName, wxTreeItemId aParentId,
@@ -1108,6 +1114,7 @@ class SCH_EDIT_FRAME : public SCH_BASE_FRAME
     std::vector<LIB_ID>         m_designBlockHistoryList;
     SCH_DESIGN_BLOCK_PANE*      m_designBlocksPane;
     PANEL_REMOTE_SYMBOL*        m_remoteSymbolPane;
+    CHATPCB_PANEL*              m_chatPcbPanel;

     wxChoice*                   m_currentVariantCtrl;
